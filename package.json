{
  "name": "clockout",
  "version": "1.0.0",
  "private": true,
  "description": "Ease compression burnout: track Claude Code workload, save open work, write tomorrow's list and pause agents until morning.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "npm run build:web --silent && tsx server/index.ts",
    "demo": "npm run build:web --silent && tsx scripts/demo.ts",
    "build:web": "vite build --logLevel warn",
    "agent": "tsx agent/remote.ts",
    "clockout": "tsx agent/cli.ts clockout",
    "resume": "tsx agent/cli.ts resume",
    "today": "tsx agent/today.ts",
    "autostart": "tsx agent/autostart.ts",
    "setup-claude": "tsx agent/setup.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
