# Optional: adds a Claude-written "where you left off" summary to tomorrow's list.
ANTHROPIC_API_KEY=
# Optional: model for the summary (default claude-opus-5-5).
CLOCKOUT_MODEL=
# Optional: port (default 4321).
PORT=
# Optional: colon-separated folders to scan for git repos (default: your home folder, depth 3).
CLOCKOUT_SCAN_ROOTS=
